# Copy to `.env` next to docker-compose.yml and fill in.
# `.env` is gitignored.

# Login password for the web UI. If you leave this unset, the backend
# generates one on first boot and prints it once to its logs.
APP_PASSWORD=

# Browser origins allowed to call the API. This must include the URL you
# open the UI on. JSON list; "*" is rejected because it is unsafe when
# combined with cookie auth.
ALLOWED_ORIGINS=["http://localhost:3000"]

# Set to true when serving over HTTPS so the session cookie is TLS-only.
COOKIE_SECURE=false

# Expose the interactive API docs at /docs.
ENABLE_DOCS=false

# Timezone used in recording filenames, e.g. America/New_York.
TZ=UTC

# Maximum simultaneous recordings.
MAX_CONCURRENT_RECORDINGS=10
